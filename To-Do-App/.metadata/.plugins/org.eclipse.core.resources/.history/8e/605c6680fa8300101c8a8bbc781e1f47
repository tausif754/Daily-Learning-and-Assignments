package com.wipro.tausif.service;




import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import com.wipro.tausif.model.Priority;
import com.wipro.tausif.model.Task;
import com.wipro.tausif.repo.TaskRepository;

import java.util.List;
import java.util.Optional;

@Service @RequiredArgsConstructor
public class TaskService {
  private final TaskRepository repo;

  public Task create(Task t) { return repo.save(t); }
  public List<Task> findAll() { return repo.findAll(); }
  public Optional<Task> findById(Long id) { return repo.findById(id); }
  public List<Task> findByPriority(Priority p) { return repo.findByPriority(p); }
  public void delete(Long id) { repo.deleteById(id); }

  public Optional<Task> update(Long id, Task incoming) {
    return repo.findById(id).map(t -> {
      t.setTaskDesc(incoming.getTaskDesc());
      t.setPriority(incoming.getPriority());
      t.setMarkThisTask(incoming.isMarkThisTask());
      return repo.save(t);
    });
  }

  public Optional<Task> toggleDone(Long id, boolean done) {
    return repo.findById(id).map(t -> {
      t.setMarkThisTask(done);
      return repo.save(t);
    });
  }
}
